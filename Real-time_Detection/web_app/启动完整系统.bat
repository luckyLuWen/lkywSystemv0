@echo off
chcp 65001 >nul
color 0A
echo.
echo ╔════════════════════════════════════════════════════════════╗
echo ║     两客一危交通事故检测系统 - 完整启动脚本                ║
echo ╚════════════════════════════════════════════════════════════╝
echo.

echo [步骤 1/3] 启动后端服务器...
cd backend
start "🔥 YOLO检测后端" cmd /k "python app.py"
cd ..
timeout /t 3 >nul

echo [步骤 2/3] 等待服务器初始化...
timeout /t 2 >nul

echo [步骤 3/3] 打开Web界面...
cd frontend
start "" "index.html"
cd ..

echo.
echo ╔════════════════════════════════════════════════════════════╗
echo ║                    ✅ 系统启动完成！                        ║
echo ╚════════════════════════════════════════════════════════════╝
echo.
echo 📋 功能说明：
echo.
echo   1️⃣  图片检测 - 上传图片进行火灾检测
echo   2️⃣  视频检测 - 上传视频进行抽帧检测
echo   3️⃣  实时检测 - 支持两种模式：
echo       • 📷 本地摄像头 - 直接使用电脑摄像头
echo       • 📡 RTMP流 - 接收OBS推流（模拟真实监控）
echo.
echo ╔════════════════════════════════════════════════════════════╗
echo ║              🎥 使用RTMP实时检测的步骤                      ║
echo ╚════════════════════════════════════════════════════════════╝
echo.
echo   1. 打开 OBS Studio
echo   2. 添加媒体源（选择火灾视频）
echo   3. 工具 → 推流服务器设置
echo      - 端口: 1935
echo      - 路径: /live
echo   4. 点击"开始串流"
echo   5. 在Web界面选择"实时检测"标签
echo   6. 选择"RTMP流（OBS推流）"
echo   7. 点击"启动推流检测"
echo.
echo 💡 提示：
echo   - 后端地址: http://localhost:5000
echo   - 推流地址: rtmp://127.0.0.1:1935/live
echo   - 可以用VLC测试推流是否正常
echo.
echo ════════════════════════════════════════════════════════════
echo.
pause
